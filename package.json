{
  "name": "mitramatika",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && next dev",
    "build": "node scripts/check-node-version.mjs && node scripts/copy-pdfjs-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:smoke": "tsx --conditions=react-server --env-file-if-exists=.env.local src/lib/ai/smoke.ts",
    "eval": "tsx --conditions=react-server --env-file-if-exists=.env.local src/features/eval/service/cli.ts",
    "eval:real": "tsx --conditions=react-server --env-file-if-exists=.env.local src/features/eval/service/cli.ts --real",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local src/lib/db/migrate.ts",
    "db:seed:curriculum": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-curriculum.ts",
    "test:generation:staging": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/generation-staging.ts",
    "test:jobs:staging": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs-staging.ts",
    "test:rls:staging": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/rls-staging.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@hookform/resolvers": "7.0.7",
    "@react-pdf/renderer": "4.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "docx": "9.7.2",
    "drizzle-orm": "1.0.0-rc.5",
    "file-type": "22.3.0",
    "jszip": "3.10.2",
    "katex": "0.18.7",
    "lucide-react": "^1.48.0",
    "mammoth": "1.13.0",
    "mathjax-full": "3.2.2",
    "mathjs": "^15.2.0",
    "mathml2omml": "0.5.0",
    "next": "16.4.5",
    "next-intl": "4.15.1",
    "pdfjs-dist": "6.5.438",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.92.0",
    "resend": "6.9.4",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "^0.5.8",
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.5.1",
    "msw": "3.0.5",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.12.1 <27"
  }
}
