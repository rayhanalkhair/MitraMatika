# Copy this file to .env.local and fill in your own keys. Never commit .env.local.
# Groq (https://console.groq.com/keys) — free tier, used for generation and cross-check.
GROQ_API_KEY=
# Google AI Studio (https://aistudio.google.com/app/apikey) — free tier, curriculum-only fallback (data class C0 only).
GOOGLE_API_KEY=

# Postgres. For development use a LOCAL or throwaway database, e.g.
# postgres://postgres:postgres@localhost:5432/mitramatika. Point it at STAGING only to run the
# *:staging scripts (with --confirm-staging), never at production; production's value goes into
# Vercel's own environment variable settings, not this file. The app (Vercel) uses the pooled
# connection string; `pnpm db:migrate` and `pg_dump` use the unpooled (direct) one.
DATABASE_URL=

# Better Auth. BETTER_AUTH_SECRET signs sessions: a long random string of at least 32 characters
# (e.g. `openssl rand -hex 32`). BETTER_AUTH_URL is the app's origin, without a trailing slash
# (http://localhost:3000 locally). Server-only: never prefix either with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application"). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google.
# Leave both empty to turn Google sign-in off; sign-up with a password still works if email is set up.
# In production the OAuth consent screen must be PUBLISHED, not limited to test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com/api-keys) sends the verification and password-reset emails. EMAIL_FROM
# must use a domain verified in Resend, e.g. "MitraMatika <masuk@example.com>". Both are REQUIRED
# in production (without them nobody can finish a password sign-up or reset a password). If either
# is empty, no email is sent.
RESEND_API_KEY=
EMAIL_FROM=

# Job runner: a long random secret (at least 32 characters, e.g. `openssl rand -hex 32`) that
# protects /api/jobs/run. Vercel Cron sends it daily as `Authorization: Bearer $CRON_SECRET` (GET);
# a manual run POSTs with the same header. Unset or too short means the route rejects every request.
# Server-only: never prefix it with NEXT_PUBLIC_. Set the same variable in Vercel (Production).
CRON_SECRET=

# Optional log level for the pino JSON logs: fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=

# Cloudflare R2 app bucket for teacher files (exports). A bucket SEPARATE from the backup bucket;
# an API token with Object Read and Write on that bucket only. R2_ACCOUNT_ID is the Cloudflare
# account id (the endpoint is https://<id>.r2.cloudflarestorage.com). All four must be set together;
# if any is empty, development and tests use an in-memory store and production refuses to store files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_APP_BUCKET=

# Access gate (ADR-0022). Sign-up is open, but an account can use the app only when its email is
# approved. ALLOWED_EMAILS: comma-separated addresses, case-insensitive, exact match (no Gmail dot
# or +tag folding). A change in Vercel needs a redeploy. Locally put your own address here, or
# every account is pending.
ALLOWED_EMAILS=
# ADMIN_EMAIL is always approved and receives the new-account and storage notices.
ADMIN_EMAIL=
